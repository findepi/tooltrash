#!/usr/bin/env bash
# Usage: git gh-range-diff https://github.com/<org>/<repo>/compare/<sha1>..<sha2>
set -euo pipefail

re='^(https://github\.com/[^/]+/[^/]+)/compare/([0-9a-f]+)\.\.\.?([0-9a-f]+)$'
[[ $# -eq 1 && $1 =~ $re ]] || { echo "usage: $0 https://github.com/<org>/<repo>/compare/<sha1>..<sha2>" >&2; exit 1; }
repo=${BASH_REMATCH[1]} first=${BASH_REMATCH[2]} second=${BASH_REMATCH[3]}

+ git fetch -q "$repo" "$first" "$second"
exec + git range-diff "$first...$second"
